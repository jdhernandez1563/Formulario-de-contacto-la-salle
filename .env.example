# Ambiente activo: development, test o production
NODE_ENV=development

# Puerto HTTP de la aplicación
PORT=3000

# Conexión PostgreSQL (reemplazar con valores locales o administrados)
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/formulario_lasalle

# Esquema aislado para el ambiente activo
DATABASE_SCHEMA=development

# Usar true solo si el proveedor exige TLS
DATABASE_SSL=false

# true únicamente para habilitar trazas detalladas
ENABLE_DEBUG=true
